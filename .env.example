# Copy to .env and fill in. .env is git-ignored and must NEVER be committed.
# Stripe keys here are TEST mode only. A committed Stripe key — even a test one — is a repo-hygiene failure.

# --- PostgreSQL ---
DATABASE_URL=postgres://billing:billing@localhost:5432/billing?sslmode=disable
POSTGRES_USER=billing
POSTGRES_PASSWORD=billing
POSTGRES_DB=billing

# --- HTTP server ---
PORT=8080

# --- Stripe (TEST MODE ONLY) ---
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_PRO=price_replace_me
