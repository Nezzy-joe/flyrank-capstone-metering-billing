# Copy to .env and fill in. .env is git-ignored and must NEVER be committed.
# Stripe keys here are TEST mode only. A committed Stripe key — even a test one — is a repo-hygiene failure.

# --- PostgreSQL ---
# POSTGRES_HOST_PORT is the host port Docker publishes Postgres on. If 5432 is
# already in use on your machine, change it AND the port in DATABASE_URL to match
# (e.g. 5434). The container always listens on 5432 internally.
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgres://billing:billing@localhost:5432/billing?sslmode=disable
POSTGRES_USER=billing
POSTGRES_PASSWORD=billing
POSTGRES_DB=billing

# --- HTTP server ---
PORT=8080

# --- App (optional; defaults shown) ---
APP_ENV=development
# DB_MAX_CONNS=10
# DB_MIN_CONNS=0
# SHUTDOWN_TIMEOUT_SECONDS=10

# --- Stripe (TEST MODE ONLY) ---
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_PRO=price_replace_me
